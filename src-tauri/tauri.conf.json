{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "智配通 面單列印",
  "version": "0.1.0",
  "identifier": "com.weimi.cix3752i.labelprint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "智配通 - 本地分揀中介",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "本地分揀中介與面單列印工具",
    "longDescription": "整合本地分揀中介 HTTP 服務、雲端 API 包裹查詢、本機面單列印的智配通 面單列印工具。"
  }
}
