# === Node ===
node_modules/
dist/
.vite/
package-lock.json
# yarn.lock 入版控(供 Dependabot 漏洞掃描 + 可重現建置)。
# 本專案以 yarn 管理依賴,yarn.lock 含全部平台的 optional binding(darwin/linux/win32),
# 不會有 npm lock 那種「host 平台鎖死、其他平台 binding 缺席」的問題。

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Editor / IDE ===
.vscode/
.idea/
*.swp
*.swo

# === macOS ===
.DS_Store

# === Office 暫存 / 鎖檔(Word / Pandoc) ===
~$*
.~*

# === Rust / Tauri 產物 ===
/src-tauri/target/
/src-tauri/gen/

# === 本地資料(執行時生成) ===
/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# === 環境變數 ===
.env
.env.local

# === 本地備份(搬移過的檔案、reference 截圖等) ===
backups/

# === AI 工具工作目錄 ===
.claude/
.serena/

# === 測試產物(tests/docker-ubuntu-build.sh build 出的 tarball,40MB+ 不入 git)===
/tests/tarballs/

# === 程式碼圖譜索引產物(本地分析用,不入 git)===
# .gitnexus 已自帶內層 .gitignore;graphify-out 為 graphify 產出(graph.html/json 約 3MB)
graphify-out/
